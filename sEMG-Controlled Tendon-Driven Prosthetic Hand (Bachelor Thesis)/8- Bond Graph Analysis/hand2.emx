implementation_end;
      Servo_limiter 472 416
       description '<Description>
 <Version>4.0</Version>
 <IsMainModel>1</IsMainModel>
 <KeepParameterValues>False</KeepParameterValues>
 <LibraryPath>Bond Graph\C.emx</LibraryPath>
 <TimeStamp>2007-10-31 10:43:59</TimeStamp>

<?xml version="1.0" ?>
<!--
  MS4 - Track 01: Empty 2-Lane Track
  Team 18

  Same corrected scale as the updated city/racing tracks:
    Track length       : 10.0 m  (X: 0 -> 10)
    Total track width  : 0.75 m
    Lane width         : 0.375 m
    Lane 1 center      : y = +0.1875 m
    Lane 2 center      : y = -0.1875 m

  No obstacles are used in this empty track.

  Vehicle:
    Small Ackermann model suitable for 0.75 m total track width.
    Approx. chassis size    : 0.402 m long x 0.200 m wide x 0.114 m high
    Approx. wheel separation: 0.250 m
    Approx. wheelbase       : 0.302 m
    Wheel radius            : 0.060 m

  Car starts at: x = 0.35 m, y = 0.0 m, heading = 0 rad
-->
<sdf version="1.6">
  <world name="empty_track">

    <!-- ═══════════════════════════════════════
         PHYSICS & CORE PLUGINS
    ═══════════════════════════════════════ -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ═══════════════════════════════════════
         LIGHTING
    ═══════════════════════════════════════ -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ═══════════════════════════════════════
         GROUND PLANE
    ═══════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 8</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 8</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.6 0.4 1</ambient>
            <diffuse>0.4 0.6 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════
         TRACK ROAD SURFACE
         Correct dimensions: 10.0 m x 0.75 m
         Track centerline: y = 0
         Lane 1: y = 0 to +0.375
         Lane 2: y = 0 to -0.375
    ═══════════════════════════════════════ -->
    <model name="road_surface">
      <static>true</static>
      <pose>5.0 0 0.002 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10.0 0.75 0.004</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10.0 0.75 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Lane divider at y = 0 -->
    <model name="lane_divider">
      <static>true</static>
      <pose>5.0 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>10.0 0.015 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════
         BOUNDARY WALLS
         Track inner edges:
           top edge    y = +0.375
           bottom edge y = -0.375
         Wall thickness = 0.05 m
         Therefore wall centers:
           top wall    y = +0.400
           bottom wall y = -0.400
    ═══════════════════════════════════════ -->
    <model name="wall_top">
      <static>true</static>
      <pose>5.0 0.400 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10.0 0.05 0.35</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10.0 0.05 0.35</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.0 1</ambient>
            <diffuse>0.8 0.8 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_bottom">
      <static>true</static>
      <pose>5.0 -0.400 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10.0 0.05 0.35</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10.0 0.05 0.35</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.0 1</ambient>
            <diffuse>0.8 0.8 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Start wall: inner face at x = 0 -->
    <model name="wall_start">
      <static>true</static>
      <pose>-0.025 0 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.85 0.35</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.85 0.35</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- End wall: inner face at x = 10 -->
    <model name="wall_end">
      <static>true</static>
      <pose>10.025 0 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.85 0.35</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.85 0.35</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════
         ACKERMANN VEHICLE
         Start: x = 0.35, y = 0, heading = 0
    ═══════════════════════════════════════ -->
    <model name="vehicle_blue">
      <pose>0.35 0 0.065 0 0 0</pose>

      <link name="chassis">
        <pose>-0.030285 0 0.035 0 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.005</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.015</iyy>
            <iyz>0</iyz>
            <izz>0.018</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.402284 0.2 0.113745</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 1.0 1</ambient>
            <diffuse>0.5 0.5 1.0 1</diffuse>
            <specular>0.0 0.0 1.0 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.402284 0.2 0.113745</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="front_left_wheel">
        <pose>0.110857 0.125006 -0.005 -1.5707 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00003</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00003</iyy>
            <iyz>0</iyz>
            <izz>0.00005</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder>
              <length>0.03</length>
              <radius>0.06</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <length>0.03</length>
              <radius>0.06</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
                <fdir1>0 0 1</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="rear_left_wheel">
        <pose>-0.191428 0.125006 -0.005 -1.5707 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00003</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00003</iyy>
            <iyz>0</iyz>
            <izz>0.00005</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder>
              <length>0.03</length>
              <radius>0.06</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <length>0.03</length>
              <radius>0.06</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
                <fdir1>0 0 1</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="front_right_wheel">
        <pose>0.110856 -0.125006 -0.005 -1.5707 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00003</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00003</iyy>
            <iyz>0</iyz>
            <izz>0.00005</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder>
              <length>0.03</length>
              <radius>0.06</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <length>0.03</length>
              <radius>0.06</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
                <fdir1>0 0 1</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="rear_right_wheel">
        <pose>-0.191428 -0.125006 -0.005 -1.5707 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00003</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00003</iyy>
            <iyz>0</iyz>
            <izz>0.00005</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder>
              <length>0.03</length>
              <radius>0.06</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <length>0.03</length>
              <radius>0.06</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
                <fdir1>0 0 1</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="front_left_wheel_steering_link">
        <pose>0.110857 0.100000 0.004 0 0 0</pose>
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00001</iyy>
            <iyz>0</iyz>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <visual name="steering_link_visual">
          <geometry>
            <cylinder>
              <length>0.02</length>
              <radius>0.01</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="front_right_wheel_steering_link">
        <pose>0.110857 -0.100000 0.004 0 0 0</pose>
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00001</iyy>
            <iyz>0</iyz>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <visual name="steering_link_visual">
          <geometry>
            <cylinder>
              <length>0.02</length>
              <radius>0.01</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="front_left_wheel_steering_joint" type="revolute">
        <child>front_left_wheel_steering_link</child>
        <parent>chassis</parent>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-0.6</lower>
            <upper>0.6</upper>
            <velocity>1.0</velocity>
            <effort>5</effort>
          </limit>
          <use_parent_model_frame>1</use_parent_model_frame>
        </axis>
      </joint>

      <joint name="front_right_wheel_steering_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_right_wheel_steering_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-0.6</lower>
            <upper>0.6</upper>
            <velocity>1.0</velocity>
            <effort>5</effort>
          </limit>
          <use_parent_model_frame>1</use_parent_model_frame>
        </axis>
      </joint>

      <joint name="front_left_wheel_joint" type="revolute">
        <parent>front_left_wheel_steering_link</parent>
        <child>front_left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name="front_right_wheel_joint" type="revolute">
        <parent>front_right_wheel_steering_link</parent>
        <child>front_right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name="rear_left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>rear_left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name="rear_right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>rear_right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <!-- Ackermann Steering Plugin -->
      <plugin filename="gz-sim-ackermann-steering-system"
              name="gz::sim::systems::AckermannSteering">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
        <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>

        <kingpin_width>0.20</kingpin_width>
        <steering_limit>0.55</steering_limit>
        <wheel_base>0.302284</wheel_base>
        <wheel_separation>0.25</wheel_separation>
        <wheel_radius>0.06</wheel_radius>

        <min_velocity>-1.5</min_velocity>
        <max_velocity>1.5</max_velocity>
        <min_acceleration>-1.0</min_acceleration>
        <max_acceleration>1.0</max_acceleration>

        <topic>/model/vehicle_blue/cmd_vel</topic>
        <odom_topic>/model/vehicle_blue/odometry</odom_topic>
        <tf_topic>/model/vehicle_blue/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>vehicle_blue/chassis</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher"/>

    </model>

  </world>
</sdf>
